# Supabase project settings.
# Copy this file to .env.local and replace both placeholders.
# These values are safe to expose to the browser when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Plaid server-only credentials. Never prefix these with NEXT_PUBLIC_.
PLAID_CLIENT_ID=your-sandbox-client-id
PLAID_SECRET=your-sandbox-secret
PLAID_ENV=sandbox
PLAID_ACCESS_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Supabase server-only key used only by authenticated server routes for private Plaid rows.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Optional: set after deploying the webhook route.
PLAID_WEBHOOK_URL=
